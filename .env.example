# Copia este archivo como .env y llena tus valores. El archivo .env NO se sube a GitHub.
# Lo usa docker-compose.yml.

# Perfil de Spring Boot: desarrollo, pre-produccion o produccion
SPRING_PROFILES_ACTIVE=desarrollo

# Base de datos (la crea Docker la primera vez con estos datos)
DB_USERNAME=kairos
DB_PASSWORD=cambia-esta-clave

# Clave para firmar los tokens JWT: mínimo 32 caracteres
JWT_SECRET=cambia-esta-clave-secreta-de-32-caracteres-min

# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@kairos.com
ADMIN_PASSWORD=cambia-esta-clave

# Superadministrador de la plataforma: aprueba las empresas (se crea al arrancar si no existe)
SUPERADMIN_EMAIL=superadmin@kairos.com
SUPERADMIN_PASSWORD=cambia-esta-clave

# Frontend (CORS y enlaces del correo)
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Carpeta del frontend (repositorio Juanes-Torres/Frontend), relativa a esta carpeta
FRONTEND_PATH=../../frontend
# Puerto de la página en tu computadora (si lo cambias, cambia también CORS_ORIGINS y FRONTEND_URL)
FRONTEND_PORT=5173

# Puerto del backend en tu computadora
SERVER_PORT=8080

# Correo de bienvenida (opcional). Contraseña de aplicación de Google, ver docs/correo.md
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Opcionales (si no están, se usan estos valores por defecto)
# JWT_EXPIRATION_MS=3600000
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# APIs externas (públicas, sin clave)
# APIS_TIMEOUT_MS=5000
# CODIGO_BARRAS_API_URL=https://api.upcitemdb.com
# QR_API_URL=https://api.qrserver.com
# Logs: nivel (DEBUG, INFO, WARN, ERROR), formato JSON en consola (ecs) y archivo opcional para Grafana + Loki
# LOG_LEVEL=INFO
# LOG_FORMAT=ecs
# LOG_FILE=logs/kairos.log

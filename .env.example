# Copia este archivo como .env y llena tus valores. El archivo .env NO se sube a GitHub.
# Lo usa docker-compose.yml.

# Perfil de Spring Boot: desarrollo, pre-produccion o produccion
SPRING_PROFILES_ACTIVE=desarrollo

# Base de datos (la crea Docker la primera vez con estos datos)
DB_USERNAME=kairos
DB_PASSWORD=cambia-esta-clave

# Clave para firmar los tokens JWT: mínimo 32 caracteres
JWT_SECRET=cambia-esta-clave-secreta-de-32-caracteres-min

# Administrador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@kairos.com
ADMIN_PASSWORD=cambia-esta-clave

# Frontend (CORS y enlaces del correo)
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Puerto del backend en tu computadora
SERVER_PORT=8080

# Correo de bienvenida (opcional). Contraseña de aplicación de Google, ver docs/correo.md
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
